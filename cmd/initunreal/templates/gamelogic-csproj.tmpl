<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared game-logic assembly for {{.GameName}}.

    The game logic lives in its own assembly so that the serializer identity matches
    everywhere: the prebuilt serializer generated by the bridge build references the
    concrete game types (PlayerModel, PlayerActions, ...) by assembly identity, and both
    the game's bridge host (Bridge/{{.GameName}}.Bridge.csproj, compiled into the
    NativeAOT bridge library) and SerializerGen see this assembly. The Unreal side never
    compiles game logic: all gameplay stays in C#, reached through the bridge's
    commands, queries and events.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <Version>0.1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Metaplay analyzers (the integration-type source generator), attached from
         the SDK's prebuilt DLLs the same way MetaplaySDK's own Directory.Build.targets
         attaches them for projects inside the SDK tree. -->
    <Analyzer Include="{{.SdkRelFromGameLogic}}/Client/PrebuiltAnalyzers/Metaplay.CodeAnalyzers.dll" />
    <Analyzer Include="{{.SdkRelFromGameLogic}}/Client/PrebuiltAnalyzers/Metaplay.CodeAnalyzers.Shared.dll" />
    <!-- Not an analyzer itself, but must be included as one so Roslyn's isolated analyzer
         assembly context can resolve it as a dependency of Metaplay.CodeAnalyzers.Shared. -->
    <Analyzer Include="{{.SdkRelFromGameLogic}}/Client/PrebuiltAnalyzers/Metaplay.Attributes.dll" />
    <ProjectReference Include="{{.SdkRelFromGameLogic}}/Dotnet/Client/Metaplay.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharedCode\**\*.cs" LinkBase="SharedCode" />
  </ItemGroup>

</Project>
